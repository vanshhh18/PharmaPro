# AIVOA environment template.
# Copy this file to `.env` in the repository root (or `backend/.env`) and edit values.
# Never commit the real .env file.

# --- PostgreSQL connection ---
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=aivoa
DATABASE_PASSWORD=change-me
DATABASE_NAME=aivoa

# Optional: full SQLAlchemy URL. When set, it overrides the values above.
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/aivoa

# --- Backend app ---
ENVIRONMENT=development
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- AI workflow (Milestone 4) ---
# Without a key, POST /api/analysis answers 503 with a clear message.
GROQ_API_KEY=
# Any current Groq chat model supporting json_object responses.
GROQ_MODEL=openai/gpt-oss-120b

# --- Frontend (read at build/dev time, safe to expose; the Groq key is NOT used in the browser) ---
# Leave empty to use the Vite dev proxy. Set to e.g. http://localhost:8000 for a standalone API host.
VITE_API_BASE_URL=
